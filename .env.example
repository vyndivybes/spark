# Google Gemini API Key
# Get yours here: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_api_key_here

# Host-configured read-only MCP services. SPARK never accepts executables or
# credentials from a socket; only this host env var (or start-spark.ps1) may
# register them. Each entry: { command, args, read_tools } (stdio) or
# { transport "streamable-http", url, headers, read_tools }.
#
# start-spark.ps1 sets this automatically for the bundled Graphify knowledge
# graph so the query_spark_graph voice tool can answer architecture questions.
# Example (Windows, adjust paths):
# SPARK_MCP_SERVERS={"graphify":{"command":"C:\\\\path\\\\.venv\\\\Scripts\\\\graphify-mcp.exe","args":["--graph","C:\\\\path\\\\graphify-out\\\\graph.json"],"read_tools":["query_graph"]}}
SPARK_MCP_SERVERS=
