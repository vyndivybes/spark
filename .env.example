# Google Gemini API Key
# Get yours here: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_api_key_here

# Optional SPARK -> VAOS Jarvis bridge (server-side only; never copy keys to the renderer).
# Configure matching VAOS_SPARK_BRIDGE_TOKEN and VAOS_SPARK_DEVICE_ID as VAOS runtime secrets.
# SPARK_JARVIS_URL=https://your-vaos-worker.example
# SPARK_JARVIS_DEVICE_ID=spark-windows-1
# SPARK_JARVIS_TOKEN=replace_with_cryptographically_random_32_plus_character_secret
