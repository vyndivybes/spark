{
  "name": "spark",
  "version": "1.0.0",
  "description": "SPARK — immersive AI workstation and experience hub",
  "main": "electron/main.js",
  "scripts": {
    "dev": "concurrently -k --success first \"vite\" \"wait-on tcp:5173 && npx electron .\"",
    "build": "vite build",
    "start": "npx electron .",
    "test": "node --test",
    "setup:experiences": "git submodule update --init --recursive",
    "icon": "node scripts/make_spark_icon.mjs",
    "shortcut": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/create-desktop-shortcut.ps1",
    "shortcut:remove": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/remove-desktop-shortcut.ps1",
    "build:python": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/build-python-runtime.ps1",
    "dist:win": "npm run icon && npm run build:python && npm run build && electron-builder --win"
  },
  "keywords": [],
  "author": "",
  "license": "MIT",
  "build": {
    "appId": "com.spark.workstation",
    "productName": "SPARK",
    "directories": {
      "output": "release"
    },
    "files": [
      "electron/**/*",
      "dist/**/*",
      "package.json"
    ],
    "extraResources": [
      { "from": "backend", "to": "backend", "filter": ["**/*", "!**/__pycache__/**", "!.env"] },
      { "from": "public", "to": "public" },
      { "from": "vendor", "to": "vendor", "filter": ["**/*", "!**/node_modules/**", "!**/.git/**"] },
      { "from": "scripts", "to": "scripts", "filter": ["*.py"] },
      { "from": "requirements-runtime.txt", "to": "requirements-runtime.txt" },
      { "from": "python-runtime", "to": "python-runtime", "filter": ["**/*", "!**/__pycache__/**"] }
    ],
    "asarUnpack": [
      "electron/experience-manager.cjs"
    ],
    "win": {
      "target": ["nsis", "portable"],
      "icon": "public/spark.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "SPARK",
      "installerIcon": "public/spark.ico",
      "uninstallerIcon": "public/spark.ico"
    }
  },
  "dependencies": {
    "@mediapipe/tasks-vision": "^0.10.22-rc.20250304",
    "@react-three/drei": "^9.99.0",
    "@react-three/fiber": "^8.15.16",
    "@types/three": "^0.160.0",
    "clsx": "^2.1.0",
    "framer-motion": "^11.0.0",
    "lucide-react": "^0.300.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "socket.io-client": "^4.7.4",
    "tailwind-merge": "^2.2.0",
    "three": "^0.160.0"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.2.1",
    "autoprefixer": "^10.4.17",
    "concurrently": "^8.2.2",
    "cross-env": "^7.0.3",
    "electron": "^28.2.0",
    "electron-builder": "^24.13.3",
    "postcss": "^8.4.35",
    "tailwindcss": "^3.4.1",
    "vite": "^5.1.0",
    "wait-on": "^7.2.0"
  }
}
